# development o production. Cambiar el entorno no cambia automáticamente la base.
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/finanzas
# Para Atlas: mongodb+srv://<db_username>:<db_password>@tu-cluster.mongodb.net/finanzas
USER_MONGO=
PASSWORD_MONGO=
PORT=3001
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Obligatorio: genera un secreto aleatorio de al menos 32 caracteres y mantenlo estable.
JWT_SECRET=
# Credenciales de la primera cuenta. Solo se usan si todavía no existe.
INITIAL_USERNAME=michael
INITIAL_PASSWORD=
